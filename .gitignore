__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Node / web
node_modules/
web/dist/
*.log

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
