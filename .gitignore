# Data, database, and ingest scratch
data/*
!data/.gitkeep
# Keep the captures/ dir in the tree, but not the capture files inside it.
!data/captures/
data/captures/*
!data/captures/.gitkeep
# Keep the ingest scratch dir in the tree, but not the temp shards inside it.
!data/scratch/
data/scratch/*
!data/scratch/.gitkeep
# Keep a headers-only given-names template, but not the real names.csv.
!data/names.example.csv
*.duckdb
*.duckdb.wal
*.parquet
*.pcap
*.pcapng

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Node / web
node_modules/
web/dist/
*.log

# Local run/ PIDs + logs from scripts/run.sh
.run/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
