# Data, database, and ingest scratch
data/*
!data/.gitkeep
# Keep the captures/ dir in the tree, but not the capture files inside it.
!data/captures/
data/captures/*
!data/captures/.gitkeep
# Keep the names/ dir + a headers-only template, but not real name CSVs.
!data/names/
data/names/*
!data/names/names.example.csv
# Keep the portmap/ dir + a headers-only template, but not the real registry CSV.
!data/portmap/
data/portmap/*
!data/portmap/portmap.example.csv
*.duckdb
*.duckdb.wal
*.parquet
*.pcap
*.pcapng

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Node / web
node_modules/
web/dist/
*.log

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
